{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howardjarvis",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,

  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },

  // howardjarvis.app must be an active zone on this Cloudflare account.
  "routes": [
    { "pattern": "howardjarvis.app", "custom_domain": true },
    { "pattern": "www.howardjarvis.app", "custom_domain": true }
  ],

  // Every 10 minutes: src/notify.js decides whether a briefing or reminder is due.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "CLAUDE_MODEL": "claude-haiku-4-5",
    "CLAUDE_SMART_MODEL": "claude-sonnet-5-5"
  },

  // Create with: npx wrangler d1 create howardjarvis
  // then paste the returned id below. Secrets (never committed):
  //   npx wrangler secret put JARVIS_PASSWORD -c howardjarvis/wrangler.jsonc
  //   npx wrangler secret put SESSION_SECRET  -c howardjarvis/wrangler.jsonc   (any long random string)
  //   npx wrangler secret put ANTHROPIC_API_KEY -c howardjarvis/wrangler.jsonc
  // Private bucket for automatic weekly snapshots (create it first: it must exist before deploy).
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "howardjarvis-backups" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "howardjarvis",
      "database_id": "5260c160-e9e4-46c5-a453-ccddda03147a",
      "migrations_dir": "migrations"
    }
  ]
}
